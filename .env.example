# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
#
# DESARROLLO LOCAL: este .env va en la raíz del repo (npm run dev).
# PRODUCCIÓN (Docker): los secretos viven en /home/ubuntu/[LECTORAPP]/.env junto al
# docker-compose.yml, con estas claves: MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, JWT_SECRET,
# NODE_ENV, TRUST_PROXY, LOG_LEVEL. El compose los pasa al contenedor (ver DEPLOY.md).

PORT=3000
NODE_ENV=production

# MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Número de proxies de confianza delante de Node (1 = Nginx). Necesario para que el rate limit vea la IP real.
TRUST_PROXY=1

# Opcional: trace | debug | info | warn | error | silent
LOG_LEVEL=info
